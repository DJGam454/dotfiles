{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "enabled": true
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },

    "scrapling": {
      "type": "local",
      "command": [
        "/Users/divyantiwari/.config/opencode/venvs/scrapling-mcp/bin/scrapling-mcp"
      ],
      "enabled": true
    }
  }
}